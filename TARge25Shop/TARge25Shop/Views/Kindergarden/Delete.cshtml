@model TARge25Shop.Models.Kindergarden.KindergardenDeleteViewModel

    <h1>
        Kindergarden Delete
    </h1>

<form method="post" enctype="multipart/form-data">

    <input type="hidden" asp-for="Id" />

    <div class="form-group row">
        <label asp-for="Id" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <p class="form-control-plaintext">@Model.Id</p>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="GroupName" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <p class="form-control-plaintext">@Model.GroupName</p>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="ChildrenCount" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <p class="form-control-plaintext">@Model.ChildrenCount</p>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="KindergardenName" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <p class="form-control-plaintext">@Model.KindergardenName</p>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="TeacherName" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <p class="form-control-plaintext">@Model.TeacherName</p>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="CreatedAt" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <p class="form-control-plaintext">@Model.CreatedAt</p>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="UpdatedAt" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <p class="form-control-plaintext">@Model.UpdatedAt</p>
        </div>
    </div>

    @foreach (var images in Model.Image)
    {
        <partial name="_Images" model="images" />
    }

    <input asp-action="DeleteConfirmation" asp-controller="kindergarden" type="submit" class="btn btn-primary" value="Delete Confirmation" />
    <a asp-action="Index" asp-controller="kindergarden" class="btn btn-secondary">Back to List</a>

</form>